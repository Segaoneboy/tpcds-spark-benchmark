cat << 'EOF' > .gitignore
.venv/
__pycache__/
*.py[cod]
*$py.class
*.ipynb_checkpoints
data/raw/*
data/small/parquet/*
data/small/orc/*
data/small/avro/*
data/small/csv_gz/*
data/large/parquet/*
data/large/orc/*
data/large/avro/*
data/large/csv_gz/*
*.dat
*.parquet
*.orc
*.avro
*.gz
logs/spark_events/*
logs/app_runs/*
*.log
metastore_db/
derby.log
warehouse/
